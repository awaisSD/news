#--------------------------------------------------------------------
# Rename this file to .env and fill in real values for your environment.
# Never commit the real .env file.
#--------------------------------------------------------------------

CI_ENVIRONMENT = production

app.baseURL = 'https://www.example-news-site.com/'
app.indexPage = ''
# false if a TLS-terminating proxy (AWS ALB/CloudFront, etc.) sits in front
# of this app — let the proxy's own HTTP->HTTPS redirect handle it instead,
# since the app can't see the original request as secure otherwise (classic
# redirect-loop symptom). Set true only for plain Apache+mod_ssl with no
# proxy in front.
app.forceGlobalSecureRequests = false

#--------------------------------------------------------------------
# Database
#--------------------------------------------------------------------

database.default.hostname = 127.0.0.1
database.default.database = news_web
database.default.username = news_web_app
database.default.password = changeme
database.default.DBDriver = MySQLi
database.default.port = 3306
database.default.charset = utf8mb4
database.default.DBCollat = utf8mb4_general_ci

# Read replica — leave commented until a replica actually exists.
# When enabled, point read-heavy Models at the 'readonly' group instead of 'default'.
# database.readonly.hostname = 127.0.0.1
# database.readonly.database = news_web
# database.readonly.username = news_web_reader
# database.readonly.password = changeme
# database.readonly.DBDriver = MySQLi
# database.readonly.port = 3306

#--------------------------------------------------------------------
# Cache — starts file-based (single server). Switch handler to 'redis'
# the moment a second app server is added; see Config/Cache.php.
#--------------------------------------------------------------------

cache.handler = file
# redis.host = 127.0.0.1
# redis.port = 6379

#--------------------------------------------------------------------
# Session — starts file-based; move to redis alongside Cache once
# load-balanced across more than one app node (see Config/Session.php).
#--------------------------------------------------------------------

# Do NOT quote this value — CodeIgniter's own .env parser only unescapes
# \" inside quotes; a bare backslash in a namespaced class path (not
# followed by a quote character) isn't recognized, so the parser gives up
# and leaves the literal quote characters in the parsed value, which then
# fails Services::session()'s handler validation. Unquoted is correct here
# since the value has no spaces (.env only requires quotes for values that do).
session.driver = CodeIgniter\Session\Handlers\FileHandler
session.savePath = null

#--------------------------------------------------------------------
# Publisher identity — must exactly match Google Publisher Center
#--------------------------------------------------------------------

publisher.name = 'Your News Site'
publisher.legalName = 'Your Publishing Company LLC'
publisher.url = 'https://www.example-news-site.com/'
publisher.logoUrl = 'https://www.example-news-site.com/assets/logo-600x60.png'
publisher.logoWidth = 600
publisher.logoHeight = 60
publisher.contactEmail = 'editors@example-news-site.com'
publisher.newsLanguage = 'en'

#--------------------------------------------------------------------
# AI pipeline — provider selection and secrets.
# API keys live ONLY here (or host-level env vars). Never in the database.
#--------------------------------------------------------------------

ai.textProvider = anthropic
ai.anthropic.apiKey = 'sk-ant-changeme'
ai.anthropic.model = 'claude-sonnet-4-5'
ai.openai.apiKey = 'sk-changeme'
ai.openai.model = 'gpt-5'

ai.imageProvider = openai
ai.openai.imageModel = 'gpt-image-1'
ai.stability.apiKey = 'sk-changeme'
ai.stability.model = 'stable-image-ultra'

ai.dailyGenerationCap = 10
ai.requestTimeoutSeconds = 120

#--------------------------------------------------------------------
# CDN — image delivery origin, decoupled from the app server
#--------------------------------------------------------------------

media.cdnBaseUrl = 'https://cdn.example-news-site.com/'
media.disk = local
