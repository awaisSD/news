/vendor/
/builds/
/tests/coverage/
/tests/coverage.xml

env
.env

# ---------------------------
# Composer
# ---------------------------
composer.lock

# ---------------------------
# CodeIgniter 4 writable dir
# ---------------------------
/writable/cache/*
!/writable/cache/index.html
/writable/logs/*
!/writable/logs/index.html
/writable/session/*
!/writable/session/index.html
/writable/uploads/*
!/writable/uploads/index.html
!/writable/uploads/.gitkeep

# ---------------------------
# Publicly-served uploads (Config\Media::$uploadPath) — actual uploaded/
# AI-generated images aren't source-controlled, only the directory itself
# ---------------------------
/public/uploads/*
!/public/uploads/index.html
!/public/uploads/.gitkeep
!/public/uploads/ai/

# ---------------------------
# OS / editor cruft
# ---------------------------
.DS_Store
.idea/
.vscode/
*.swp
